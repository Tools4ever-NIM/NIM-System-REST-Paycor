    "rest": {
        "config": {
            "baseUrl": "https://{tenant_id}",
            "get": {
                "pagination": {
                    "mode": "url",
                    "field": "additionalResultsUrl",
                    "replace_in_url": true
                }
            },
            "headers": {
                "Ocp-Apim-Subscription-Key": "{subscription_id}"
            },
            "authentication": "custom_post_token",
            "call_handling": "generic",
            "test_connection": {
                "url": "/v1/tenants/{company_id}"
            },
            "socket_timeout": 3600000,
            "retry": [
                {
                    "type": "statusCode",
                    "statusCode": 429,
                    "retry": {
                        "type": "simple",
                        "maxCount": 12,
                        "waitTime": 5
                    }
                },
                {
                    "type": "statusCode",
                    "statusCode": 500,
                    "retry": {
                        "type": "simple",
                        "maxCount": 12,
                        "waitTime": 5
                    }
                },
                {
                    "type": "connectionError"
                }
            ],
            "accept": "application/json"
        },
        "authOptions": {
            "type": "custom_post_token",
            "authUrl": "https://{token_uri}",
            "postAsForm": true,
            "postData": {
                "grant_type": "refresh_token",
                "client_id": "{client_id}",
                "client_secret": "{client_secret}",
                "Ocp-Apim-Subscription-Key": "{subscription_id}",
                "refresh_token": "{client_refresh_token}"
            },
            "tokenPath": "access_token",
            "headerName": "Authorization",
            "headerTemplate": "Bearer {token}"
        }
    },
    "connection": {
        "items": [
            {
                "name": "tenant_id",
                "type": "textbox",
                "label": "Tenent URL:",
                "value": "apis.paycor.com",
                "required": true,
                "hidden": "true",
                "order": 1
            },
            {
                "name": "token_uri",
                "type": "textbox",
                "label": "OAuth Token URI",
                "value": "apis.paycor.com/sts/v1/common/token",
                "required": true,
                "hidden": "true",
                "order": 2
            },
            {
                "name": "client_id",
                "type": "textbox",
                "label": "Client Id:",
                "required": true,
                "order": 3
            },
            {
                "name": "client_secret",
                "type": "textbox",
                "password": true,
                "label": "Client Secret:",
                "required": true,
                "order": 4
            },
            {
                "name": "client_refresh_token",
                "type": "textbox",
                "password": true,
                "label": "Refresh Token:",
                "required": true,
                "order": 5
            },
            {
                "name": "subscription_id",
                "type": "textbox",
                "label": "Subscription Id:",
                "value": "",
                "required": true,
                "order": 6
            },
            {
                "name": "company_id",
                "type": "textbox",
                "label": "Company/Tenant Id:",
                "value": "",
                "required": true,
                "order": 7
            },
            {
                "name": "page_size",
                "type": "textbox",
                "label": "Page Size:",
                "value": "1000",
